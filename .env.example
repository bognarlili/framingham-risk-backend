# Only for local demonstration. Do not commit a real secret.
DB_PASSWORD=replace-with-a-local-password

# Keycloak: its own database user, and the first admin of the admin console.
KEYCLOAK_DB_PASSWORD=replace-with-another-local-password
KEYCLOAK_ADMIN_PASSWORD=replace-with-an-admin-password

# Optional: where the Nginx frontend forwards /api. Default is the backend container.
# Uncomment while the backend runs from IntelliJ on port 8082:
# FRONTEND_BACKEND_URL=http://host.docker.internal:8082
